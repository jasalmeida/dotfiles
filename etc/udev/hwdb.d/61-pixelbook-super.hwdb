# Google Pixelbook (Eve) keyboard. Overrides systemd's 60-keyboard.hwdb entry:
# - the Assistant key (between Ctrl and Alt) becomes Super
# - the top row sends plain F1-F10 instead of back/refresh/brightness/media;
#   Super + top row does those actions (cfg/pixelbook.conf in the mango config)
# - the hamburger (Menu) key at the end of the top row sends F13
evdev:atkbd:dmi:bvn*:bvr*:bd*:svnGoogle:pnEve:*
 KEYBOARD_KEY_d8=leftmeta
 KEYBOARD_KEY_3b=f1
 KEYBOARD_KEY_3c=f2
 KEYBOARD_KEY_3d=f3
 KEYBOARD_KEY_3e=f4
 KEYBOARD_KEY_3f=f5
 KEYBOARD_KEY_40=f6
 KEYBOARD_KEY_41=f7
 KEYBOARD_KEY_42=f8
 KEYBOARD_KEY_43=f9
 KEYBOARD_KEY_44=f10
 KEYBOARD_KEY_5d=f13

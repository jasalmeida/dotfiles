#!/bin/bash

# rofi in Noctalia's current colors. Noctalia rewrites its GTK 4 palette on
# every theme or wallpaper change, so the theme is regenerated from it each run.
# Arguments go straight to rofi (after the theme), e.g. -dmenu -p Prompt.
# Replaces fuzzel, whose scrolling snaps back to the item under the pointer.

css=${XDG_CONFIG_HOME:-$HOME/.config}/gtk-4.0/noctalia.css
theme=${XDG_RUNTIME_DIR:-/tmp}/rofi-noctalia.rasi

color() {
  sed -n "s/^@define-color $1 #\([0-9a-fA-F]\{6\}\).*/\1/p" "$css" 2>/dev/null | head -n1
}

bg=$(color window_bg_color); bg=${bg:-131313}
fg=$(color window_fg_color); fg=${fg:-e2e2e2}
accent=$(color accent_bg_color); accent=${accent:-bfc1ff}
on_accent=$(color accent_fg_color); on_accent=${on_accent:-222578}

cat >"$theme" <<EOF
configuration {
  font: "monospace 15";
}
* {
  background-color: transparent;
  text-color: #${fg};
}
window {
  background-color: #${bg}f2;
  border: 2px;
  border-color: #${accent};
  border-radius: 14px;
  padding: 20px 28px;
  width: 70ch;
}
mainbox {
  spacing: 14px;
}
inputbar {
  children: [prompt, entry];
  spacing: 12px;
}
prompt {
  text-color: #${accent};
}
listview {
  lines: 16;
  fixed-height: false;
  scrollbar: false;
  spacing: 2px;
}
element {
  padding: 6px 10px;
  border-radius: 8px;
}
element selected {
  background-color: #${accent};
  text-color: #${on_accent};
}
element-text {
  background-color: inherit;
  text-color: inherit;
  highlight: bold;
}
EOF

exec rofi -theme "$theme" "$@"

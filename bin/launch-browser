#!/bin/bash

# Super+Shift+Enter: open the default web browser (xdg-settings), so switching
# browsers is one setting instead of a keybinding edit. Arguments (e.g. a URL)
# are passed on.

set -euo pipefail

browser=$(xdg-settings get default-web-browser 2>/dev/null || true)
browser=${browser%.desktop}

if [[ -n $browser ]]; then
  exec gtk-launch "$browser" "$@"
fi
exec chromium "$@"

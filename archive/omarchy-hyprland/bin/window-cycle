#!/bin/bash

# Alt+Tab across all workspaces, most-recently-used first.
#   window-cycle next|prev   one Tab press (Shift+Tab for prev)
#   window-cycle reset       Alt released: end the current cycle
#
# The first press snapshots the MRU list and jumps to the previous window, so
# a quick Alt+Tab toggles between your last two windows. While Alt stays held,
# further presses walk deeper into the snapshot. The state also expires on its
# own after 10s as a safety net.
#
# Every press really focuses a window, which Hyprland records in its focus
# history. So on reset, the windows passed through are refocused oldest-first,
# then the one landed on: the start window ends up second in the MRU order
# and the passed-through ones keep their original places behind it.
#
# While cycling, the jalmeida.window-switcher shell plugin shows the windows'
# icons with the selection highlighted.

set -euo pipefail

dir=${1:-next}
state=${XDG_RUNTIME_DIR:-/tmp}/window-cycle.state
visited=$state.visited
windows=$state.windows
switcher=jalmeida.window-switcher

# One run at a time. A Tab press (focus + summon the overlay) takes ~100ms, so
# releasing Alt can start the reset while a press is still running; unserialized,
# its hide could land before that press's summon and leave the overlay up.
exec 9>"$state.lock"
flock 9
ttl_ms=10000

focus_cmd() { echo "dispatch hl.dsp.focus({ window = \"address:$1\" })"; }

restore_mru() {
  [[ -f $state && -f $visited ]] || return 0

  local list seen final addr i cmds=() passed=()
  mapfile -t list < <(tail -n +2 "$state")
  mapfile -t seen <"$visited"
  (( ${#seen[@]} )) || return 0
  final=${seen[-1]}

  # Everything focused during the cycle except the final window, in MRU order
  for addr in "${list[@]}"; do
    [[ $addr != "$final" ]] && printf '%s\n' "${seen[@]}" | grep -qxF -- "$addr" && passed+=("$addr")
  done

  # Only the start window was passed: the history is already right
  (( ${#passed[@]} > 1 )) || return 0

  for (( i = ${#passed[@]} - 1; i >= 0; i-- )); do
    cmds+=("$(focus_cmd "${passed[i]}")")
  done
  cmds+=("$(focus_cmd "$final")" "dispatch hl.dsp.window.bring_to_top()")

  local IFS=';'
  hyprctl --batch "${cmds[*]}" >/dev/null
}

if [[ $dir == reset* ]]; then
  omarchy-shell -q shell hide "$switcher"
  restore_mru
  rm -f "$state" "$visited" "$windows"
  exit 0
fi

now=$(( $(date +%s%N) / 1000000 ))
index=0
list=()

if [[ -f $state ]]; then
  read -r stamp index <"$state"
  if (( now - stamp <= ttl_ms )); then
    mapfile -t list < <(tail -n +2 "$state")
  fi
fi

if (( ${#list[@]} == 0 )); then
  hyprctl clients -j | jq -c '[.[] | select(.mapped and .workspace.id > 0)]
    | sort_by(.focusHistoryID) | map({address, class, title})' >"$windows"
  mapfile -t list < <(jq -r '.[].address' "$windows")
  index=0
  printf '%s\n' "${list[0]:-}" >"$visited"
fi

count=${#list[@]}
(( count > 1 )) || exit 0

if [[ $dir == prev ]]; then
  index=$(( (index - 1 + count) % count ))
else
  index=$(( (index + 1) % count ))
fi

{ echo "$now $index"; printf '%s\n' "${list[@]}"; } >"$state"
echo "${list[index]}" >>"$visited"

hyprctl dispatch "hl.dsp.focus({ window = \"address:${list[index]}\" })" >/dev/null
hyprctl dispatch "hl.dsp.window.bring_to_top()" >/dev/null

omarchy-shell -q shell summon "$switcher" "$(jq -c --argjson i "$index" '{windows: ., index: $i}' "$windows")" >/dev/null
